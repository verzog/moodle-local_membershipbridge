{{!
    @template local_membershipbridge/result_card

    A card showing the plain-text output of a connection test, sync or test push.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * title - The card heading.
    * help - Optional help text shown above the output.
    * output - The plain-text output, shown preformatted.

    Example context (json):
    {
        "title": "Sync result",
        "help": "The raw response returned by the membership system for each call just run.",
        "output": "Enrolments:\n1"
    }
}}
<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">{{title}}</h5>
        {{#help}}
        <p class="text-muted">{{help}}</p>
        {{/help}}
        <pre class="bg-light p-3">{{output}}</pre>
    </div>
</div>
