{{!
    @template local_membershipbridge/sync_controls

    The one-member manual sync form and connection test on the sync page.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * actionurl - The sync page URL the form posts to.
    * sesskey - The session key.
    * contactid - The member ID to show in the field.
    * canoverride - Whether to offer the look-back override (Direct REST API only).

    Example context (json):
    {
        "actionurl": "https://example.com/local/membershipbridge/admin/sync.php",
        "sesskey": "abc123",
        "contactid": "20018",
        "canoverride": true
    }
}}
<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">{{#str}} filtercontactid, local_membershipbridge {{/str}}</h5>
        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div class="form-group">
                <label for="contactid">{{#str}} contactid, local_membershipbridge {{/str}}</label>
                <input type="text" id="contactid" name="contactid" class="form-control" value="{{contactid}}"
                    placeholder="{{#str}} contactidplaceholder, local_membershipbridge {{/str}}">
                <small class="form-text text-muted">{{#str}} contactidhelp, local_membershipbridge {{/str}}</small>
            </div>
            {{#canoverride}}
            <div class="form-check mt-2">
                {{! Always shown unticked, so an override never carries over to the next sync. }}
                <input type="checkbox" id="ignorelookback" name="ignorelookback" value="1" class="form-check-input">
                <label for="ignorelookback" class="form-check-label">
                    {{#str}} reg_ignore_lookback, local_membershipbridge {{/str}}
                </label>
                <small class="form-text text-muted d-block">
                    {{#str}} reg_ignore_lookback_help, local_membershipbridge {{/str}}
                </small>
            </div>
            {{/canoverride}}
            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button type="submit" name="action" value="enrollments" class="btn btn-primary">
                    {{#str}} sync_enrollments, local_membershipbridge {{/str}}
                </button>
                <button type="submit" name="action" value="cancellations" class="btn btn-warning">
                    {{#str}} sync_cancellations, local_membershipbridge {{/str}}
                </button>
                <button type="submit" name="action" value="groups" class="btn btn-info">
                    {{#str}} sync_groups, local_membershipbridge {{/str}}
                </button>
                <button type="submit" name="action" value="all" class="btn btn-success">
                    {{#str}} sync_all, local_membershipbridge {{/str}}
                </button>
                <button type="submit" name="action" value="testconnection" class="btn btn-outline-secondary">
                    {{#str}} testconnection, local_membershipbridge {{/str}}
                </button>
            </div>
            <small class="form-text text-muted mt-2">{{#str}} testconnection_help, local_membershipbridge {{/str}}</small>
        </form>
    </div>
</div>
